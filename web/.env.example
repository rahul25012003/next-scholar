# Copy to .env.local and fill in what you have. Every one of these is optional.
# Nothing here is required to run the site, and nothing fakes a result when a
# value is missing. An unset key produces a stated "not connected" state.

# Public site origin, once a domain exists. Used only for absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=

# Claude API key for the model backed agents. Without it, those agents return
# their stated fallback and the four rule based agents keep working.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5.
NEXT_SCHOLAR_AGENT_MODEL=

# Serves the synthetic case fixtures in a production build. Off by default, so
# fabricated student records cannot reach a live deployment by accident.
NEXT_SCHOLAR_DEMO_DATA=

# Document pipeline. Both are required before a single upload is accepted: the
# pipeline refuses everything while it cannot scan, and extraction refuses to
# run while there is no stored document to read.
MALWARE_SCAN_ENDPOINT=
DOCUMENT_STORAGE_BUCKET=

# Notification providers. Each unset key shows as "not configured" on /ops
# rather than logging a pretend send.
TRANSACTIONAL_EMAIL_KEY=
WHATSAPP_BUSINESS_TOKEN=

# Shared secret for POST /api/sweep, the scheduled detection run. Without it the
# endpoint refuses to run in production rather than sitting there unauthenticated.
SWEEP_SECRET=
