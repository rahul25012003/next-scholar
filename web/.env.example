# Copy to .env.local and fill in what you have. Every one of these is optional.
# Nothing here is required to run the site, and nothing fakes a result when a
# value is missing. An unset key produces a stated "not connected" state.

# Public site origin, once a domain exists. Used only for absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=

# The database. Without both, every read and write in data/store.ts and
# data/users.ts runs against the in-memory fixtures, exactly as it does today,
# rather than failing: see supabaseConfigured() in src/lib/supabase.ts. Once
# a Supabase project exists, apply supabase/migrations/0001_schema.sql then
# 0002_rls.sql (in that order) before setting these. This is the service role
# key, not the anon key: the application's own permission matrix is the
# primary gate and runs before any query reaches this client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for the model backed agents. Without it, those agents return
# their stated fallback and the four rule based agents keep working.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5.
NEXT_SCHOLAR_AGENT_MODEL=

# Serves the synthetic case fixtures in a production build. Off by default, so
# fabricated student records cannot reach a live deployment by accident.
NEXT_SCHOLAR_DEMO_DATA=

# Document pipeline. Both are required before a single upload is accepted: the
# pipeline refuses everything while it cannot scan, and extraction refuses to
# run while there is no stored document to read.
MALWARE_SCAN_ENDPOINT=
DOCUMENT_STORAGE_BUCKET=

# Notification providers. Each unset key shows as "not configured" on /ops
# rather than logging a pretend send.
TRANSACTIONAL_EMAIL_KEY=
WHATSAPP_BUSINESS_TOKEN=

# The public WhatsApp number, with country code (non-digits are stripped).
# Unset, the "Talk to a counsellor" panel says no line exists yet instead of
# showing a WhatsApp button that goes nowhere.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Shared secret for /api/sweep, the scheduled detection run. Vercel Cron sends
# CRON_SECRET as `Authorization: Bearer`, so set that one for the daily cron.
# SWEEP_SECRET is also accepted, by bearer or the `x-sweep-secret` header, for
# manual runs. With neither set the endpoint refuses to run in production rather
# than sitting there unauthenticated.
CRON_SECRET=
SWEEP_SECRET=

# Session signing secret. At least 32 characters. Required in production: without
# it the app refuses to start rather than issuing unsigned sessions. Local
# development uses a fixed, public development secret (see src/domain/auth.ts).
SESSION_SECRET=

# Password for the seeded development accounts shown on the sign in page.
# Defaults to next-scholar-dev-1 in development. A production build creates the
# seeded accounts only when NEXT_SCHOLAR_DEMO_DATA=true and this is set, because
# the default is published in this repository. The sign in hint never renders in
# production.
SEED_ACCOUNT_PASSWORD=
